# Godot and text source files: normalize to LF.
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.csv text eol=lf
*.gdshader text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows shell scripts: keep CRLF.
*.ps1 text eol=crlf

# Binary assets: never diff or convert line endings.
*.png binary
*.ttf binary
*.ogg binary
*.wav binary
*.translation binary
